@* ===== Categories/Index.cshtml ===== *@
@model IEnumerable<Velora.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <span></span>
  <a asp-action="Create" class="btn-velora-primary"><i class="fa-solid fa-plus me-2"></i>Add Category</a>
</div>

<div class="admin-table-card">
  <div class="admin-table-header">
    <span class="admin-table-title">Categories (@Model.Count())</span>
  </div>
  <div style="overflow-x:auto;">
    <table class="admin-table">
      <thead><tr><th>Name</th><th>Slug</th><th>Order</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        @foreach (var cat in Model)
        {
          <tr>
            <td><strong>@cat.Name</strong></td>
            <td style="font-size:.78rem;color:var(--gray-400);">@cat.Slug</td>
            <td>@cat.DisplayOrder</td>
            <td>
              <span class="status-badge @(cat.IsActive ? "status-confirmed" : "status-cancelled")">
                @(cat.IsActive ? "Active" : "Inactive")
              </span>
            </td>
            <td>
              <a asp-action="Edit" asp-route-id="@cat.Id" class="btn-action btn-edit">
                <i class="fa-solid fa-pen"></i>
              </a>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
