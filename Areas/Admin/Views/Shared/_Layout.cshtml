<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | " : "")Velora Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/velora.css" asp-append-version="true">
  @await RenderSectionAsync("Styles", required: false)
</head>
<body style="background:#f8f9fa;">

<input type="hidden" id="tempSuccess" value="@TempData["Success"]">
<input type="hidden" id="tempError"   value="@TempData["Error"]">

<!-- Admin Sidebar -->
<aside class="admin-sidebar" id="adminSidebar">
  <div class="admin-sidebar-brand">
    <div class="admin-brand-name">VELORA</div>
    <div class="admin-brand-sub">Admin Panel</div>
  </div>

  <nav class="admin-nav-section">
    <div class="admin-nav-section-title">Overview</div>
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="admin-nav-link">
      <i class="fa-solid fa-chart-pie"></i> Dashboard
    </a>
  </nav>

  <nav class="admin-nav-section">
    <div class="admin-nav-section-title">Catalog</div>
    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="admin-nav-link">
      <i class="fa-solid fa-shirt"></i> Products
    </a>
    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="admin-nav-link">
      <i class="fa-solid fa-tags"></i> Categories
    </a>
  </nav>

  <nav class="admin-nav-section">
    <div class="admin-nav-section-title">Sales</div>
    <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="admin-nav-link">
      <i class="fa-solid fa-box"></i> Orders
    </a>
    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="admin-nav-link">
      <i class="fa-solid fa-users"></i> Customers
    </a>
  </nav>

  <nav class="admin-nav-section" style="margin-top:auto;">
    <div class="admin-nav-section-title">Account</div>
    <a asp-controller="Home" asp-action="Index" asp-area="" class="admin-nav-link">
      <i class="fa-solid fa-store"></i> View Store
    </a>
    <form asp-controller="Account" asp-action="Logout" asp-area="" method="post">
      @Html.AntiForgeryToken()
      <button type="submit" class="admin-nav-link w-100 text-start" style="background:none;border:none;color:rgba(255,255,255,.4);">
        <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
      </button>
    </form>
  </nav>
</aside>

<!-- Admin Main -->
<div class="admin-main">
  <!-- Topbar -->
  <header class="admin-topbar">
    <div class="d-flex align-items-center gap-3">
      <button id="adminSidebarToggle" class="d-lg-none btn-action btn-view">
        <i class="fa-solid fa-bars"></i>
      </button>
      <div>
        <div class="admin-page-title">@ViewData["Title"]</div>
        <div class="admin-breadcrumb">
          Admin / @ViewData["Title"]
        </div>
      </div>
    </div>
    <div class="d-flex align-items-center gap-3">
      <span style="font-size:.8rem;color:var(--gray-500);">@User.Identity?.Name</span>
      <div style="width:36px;height:36px;border-radius:50%;background:var(--gold);display:flex;align-items:center;justify-content:center;color:var(--black);font-weight:800;font-size:.85rem;">
        A
      </div>
    </div>
  </header>

  <!-- Content -->
  <div class="admin-content">
    @RenderBody()
  </div>
</div>

<div class="toast-container-velora"></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="/js/velora.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
