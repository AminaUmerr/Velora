@{
    ViewData["Title"] = "Contact Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section style="background:var(--black);padding:60px 0;position:relative;overflow:hidden;">
  <div class="container text-center" style="position:relative;z-index:2;">
    <span class="section-eyebrow">Get In Touch</span>
    <h1 style="font-family:var(--font-display);font-size:clamp(1.8rem,4vw,2.8rem);font-weight:700;color:white;margin-bottom:10px;">
      Contact <span style="color:var(--gold);">Us</span>
    </h1>
    <p style="color:rgba(255,255,255,.55);font-size:.9rem;">We'd love to hear from you.</p>
  </div>
</section>

<section class="section-padding">
  <div class="container">
    <div class="row g-5">

      <!-- Info -->
      <div class="col-lg-4">
        <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:28px;">Contact Information</h3>
        @foreach (var info in new[] {
          new { Icon="fa-location-dot", Title="Visit Us",       Text="Liberty Market, Gulberg III<br>Lahore, Pakistan" },
          new { Icon="fa-phone",        Title="Call Us",        Text="+92 300 1234567<br>+92 42 35770001" },
          new { Icon="fa-envelope",     Title="Email Us",       Text="hello@velora.pk<br>support@velora.pk" },
          new { Icon="fa-clock",        Title="Business Hours", Text="Mon–Sat: 10am – 8pm<br>Sun: 12pm – 6pm" },
        })
        {
          <div style="display:flex;align-items:flex-start;gap:16px;margin-bottom:24px;">
            <div style="width:44px;height:44px;background:rgba(201,168,76,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <i class="fa-solid @info.Icon text-gold" style="font-size:.9rem;"></i>
            </div>
            <div>
              <div style="font-weight:700;font-size:.85rem;margin-bottom:4px;">@info.Title</div>
              <div style="font-size:.82rem;color:var(--gray-500);line-height:1.7;">@Html.Raw(info.Text)</div>
            </div>
          </div>
        }

        <div class="d-flex gap-2 mt-4">
          @foreach (var (icon, href) in new[] {
            ("fab fa-instagram","#"),("fab fa-facebook-f","#"),("fab fa-twitter","#"),("fab fa-tiktok","#")
          })
          {
            <a href="@href" class="social-btn" style="background:var(--gray-100);color:var(--gray-600);">
              <i class="@icon"></i>
            </a>
          }
        </div>
      </div>

      <!-- Form -->
      <div class="col-lg-8">
        <div style="background:white;border-radius:var(--radius-xl);padding:40px;box-shadow:var(--shadow);">
          <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:28px;">Send Us a Message</h3>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="velora-label">Your Name</label>
              <input type="text" class="velora-input" placeholder="Full name">
            </div>
            <div class="col-md-6">
              <label class="velora-label">Email Address</label>
              <input type="email" class="velora-input" placeholder="you@example.com">
            </div>
            <div class="col-12">
              <label class="velora-label">Subject</label>
              <input type="text" class="velora-input" placeholder="How can we help?">
            </div>
            <div class="col-12">
              <label class="velora-label">Message</label>
              <textarea class="velora-textarea" rows="5" placeholder="Write your message here..."></textarea>
            </div>
            <div class="col-12">
              <button type="button" class="btn-velora-primary"
                      onclick="Velora.toast('Message sent! We\'ll get back to you soon.','success')">
                <i class="fa-solid fa-paper-plane me-2"></i> Send Message
              </button>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
