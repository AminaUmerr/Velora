@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero -->
<section style="background:var(--black);padding:80px 0;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1400') center/cover;opacity:.15;"></div>
  <div class="container text-center" style="position:relative;z-index:2;">
    <span class="section-eyebrow">Our Story</span>
    <h1 style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.5rem);font-weight:700;color:white;margin-bottom:16px;">
      About <span style="color:var(--gold);">Velora</span>
    </h1>
    <p style="color:rgba(255,255,255,.6);font-size:1rem;max-width:540px;margin:0 auto;">
      A premium fashion destination born from a passion for quality and style.
    </p>
  </div>
</section>

<section class="section-padding">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6">
        <span class="section-eyebrow">Who We Are</span>
        <h2 class="section-title mb-3">Redefining <span>Premium</span> Fashion in Pakistan</h2>
        <div class="section-divider mb-4"></div>
        <p style="color:var(--gray-600);line-height:1.8;margin-bottom:20px;">
          Velora was founded with a singular vision: to bring world-class fashion to discerning individuals across Pakistan. We curate premium clothing, footwear, timepieces, and accessories that reflect sophistication and intentional style.
        </p>
        <p style="color:var(--gray-600);line-height:1.8;">
          Every product in our collection is handpicked by our expert team and held to the highest standards of quality, craftsmanship, and design. We believe that fashion is not just about looking good — it is a form of self-expression and personal identity.
        </p>
      </div>
      <div class="col-lg-6">
        <div style="border-radius:var(--radius-xl);overflow:hidden;aspect-ratio:4/3;">
          <img src="https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?w=800"
               alt="Velora Store" style="width:100%;height:100%;object-fit:cover;">
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Stats -->
<section class="section-padding-sm bg-light-gray">
  <div class="container">
    <div class="row g-4 text-center">
      @foreach (var s in new[] {
        new { Value="10K+", Label="Happy Customers" },
        new { Value="500+", Label="Premium Products" },
        new { Value="5", Label="Collections" },
        new { Value="4.9★", Label="Average Rating" },
      })
      {
        <div class="col-6 col-md-3">
          <div style="font-family:var(--font-display);font-size:2.4rem;font-weight:900;color:var(--gold);">@s.Value</div>
          <div style="font-size:.82rem;color:var(--gray-500);font-weight:500;margin-top:4px;">@s.Label</div>
        </div>
      }
    </div>
  </div>
</section>

<!-- Values -->
<section class="section-padding">
  <div class="container">
    <div class="text-center mb-5">
      <span class="section-eyebrow">What Drives Us</span>
      <h2 class="section-title">Our Core <span>Values</span></h2>
      <div class="section-divider section-divider-center"></div>
    </div>
    <div class="row g-4">
      @foreach (var v in new[] {
        new { Icon="fa-gem",         Title="Uncompromising Quality",      Text="We source only from verified premium manufacturers, ensuring every stitch and material exceeds your expectations." },
        new { Icon="fa-leaf",        Title="Sustainable Practices",       Text="We are committed to responsible fashion — working with brands that share our values around sustainability and ethical production." },
        new { Icon="fa-handshake",   Title="Customer First",              Text="Your satisfaction is our priority. From browsing to delivery, we ensure a seamless, elevated experience at every step." },
        new { Icon="fa-lightbulb",   Title="Innovation in Style",         Text="We stay ahead of global trends to bring you curated collections that are both timeless and contemporary." },
      })
      {
        <div class="col-md-6 col-lg-3">
          <div style="text-align:center;padding:28px 20px;">
            <div style="width:56px;height:56px;background:rgba(201,168,76,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;">
              <i class="fa-solid @v.Icon text-gold" style="font-size:1.1rem;"></i>
            </div>
            <h5 style="font-size:.9rem;font-weight:700;margin-bottom:10px;">@v.Title</h5>
            <p style="font-size:.82rem;color:var(--gray-500);line-height:1.7;margin:0;">@v.Text</p>
          </div>
        </div>
      }
    </div>
  </div>
</section>
