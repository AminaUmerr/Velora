@{
    ViewData["Title"] = "Order Confirmed";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var orderNumber = ViewBag.OrderNumber as string;
}

<section style="min-height:70vh;display:flex;align-items:center;background:var(--gray-50);padding:80px 0;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-7 col-lg-6 text-center">

        <!-- Success Icon -->
        <div style="width:90px;height:90px;background:linear-gradient(135deg,var(--gold),var(--gold-dark));border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 28px;box-shadow:0 8px 32px rgba(201,168,76,0.4);">
          <i class="fa-solid fa-check" style="font-size:2rem;color:white;"></i>
        </div>

        <span class="section-eyebrow">Thank You!</span>
        <h1 style="font-family:var(--font-display);font-size:2.2rem;font-weight:700;margin-bottom:12px;">
          Order Confirmed
        </h1>
        <p style="color:var(--gray-500);font-size:.95rem;line-height:1.7;margin-bottom:28px;">
          Your order has been placed successfully. We've sent a confirmation email with your order details.
        </p>

        @if (!string.IsNullOrEmpty(orderNumber))
        {
          <div style="background:white;border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow-sm);margin-bottom:32px;">
            <div style="font-size:.72rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--gray-500);margin-bottom:8px;">Order Number</div>
            <div style="font-size:1.4rem;font-weight:800;color:var(--gold);letter-spacing:2px;">@orderNumber</div>
          </div>
        }

        <!-- Steps -->
        <div style="display:flex;justify-content:center;gap:0;margin-bottom:36px;">
          @{
            var steps = new[] {
              new { Icon="fa-circle-check", Label="Order Placed", Active=true },
              new { Icon="fa-box", Label="Processing", Active=false },
              new { Icon="fa-truck", Label="Shipped", Active=false },
              new { Icon="fa-house", Label="Delivered", Active=false },
            };
          }
          @foreach (var (step, idx) in steps.Select((s, i) => (s, i)))
          {
            <div style="display:flex;align-items:center;">
              <div style="text-align:center;min-width:70px;">
                <div style="width:40px;height:40px;border-radius:50%;margin:0 auto 6px;display:flex;align-items:center;justify-content:center;background:@(step.Active ? "var(--gold)" : "var(--gray-200)");color:@(step.Active ? "var(--black)" : "var(--gray-400)");">
                  <i class="fa-solid @step.Icon" style="font-size:.85rem;"></i>
                </div>
                <div style="font-size:.68rem;font-weight:600;color:@(step.Active ? "var(--gray-900)" : "var(--gray-400)");">@step.Label</div>
              </div>
              @if (idx < steps.Length - 1)
              {
                <div style="width:40px;height:2px;background:@(step.Active ? "var(--gold)" : "var(--gray-200)");margin-bottom:22px;"></div>
              }
            </div>
          }
        </div>

        <div class="d-flex gap-3 justify-content-center flex-wrap">
          <a asp-controller="User" asp-action="Orders" class="btn-velora-dark">
            <i class="fa-solid fa-box me-2"></i> View My Orders
          </a>
          <a asp-controller="Shop" asp-action="Index" class="btn-velora-ghost">
            Continue Shopping
          </a>
        </div>

      </div>
    </div>
  </div>
</section>
