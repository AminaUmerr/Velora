@model Velora.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="background:var(--gray-50);padding:16px 0;">
  <div class="container">
    <div class="velora-breadcrumb">
      <a asp-controller="Home" asp-action="Index">Home</a>
      <span class="sep">›</span>
      <a asp-controller="Cart" asp-action="Index">Cart</a>
      <span class="sep">›</span>
      <span class="active">Checkout</span>
    </div>
  </div>
</div>

<section class="section-padding" style="padding-top:32px;background:var(--gray-50);">
  <div class="container">
    <h1 style="font-size:1.5rem;font-weight:700;margin-bottom:32px;">Checkout</h1>

    <form asp-action="PlaceOrder" method="post" id="checkoutForm">
      @Html.AntiForgeryToken()

      <div asp-validation-summary="ModelOnly" class="velora-alert velora-alert-error mb-3"></div>

      <div class="row g-4">

        <!-- ───────── LEFT: Shipping + Payment ───────── -->
        <div class="col-lg-7">

          <!-- Shipping -->
          <div style="background:white;border-radius:var(--radius-lg);padding:28px;box-shadow:var(--shadow-sm);margin-bottom:20px;">
            <div class="checkout-section-title">
              <i class="fa-solid fa-location-dot me-2"></i>Shipping Information
            </div>
            <div class="row g-3">
              <div class="col-12">
                <label class="velora-label">Full Name *</label>
                <input asp-for="FullName" class="velora-input" placeholder="Your full name">
                <span asp-validation-for="FullName" class="text-danger" style="font-size:.73rem;"></span>
              </div>
              <div class="col-12">
                <label class="velora-label">Shipping Address *</label>
                <input asp-for="ShippingAddress" class="velora-input" placeholder="House #, Street, Area">
                <span asp-validation-for="ShippingAddress" class="text-danger" style="font-size:.73rem;"></span>
              </div>
              <div class="col-md-6">
                <label class="velora-label">City *</label>
                <input asp-for="City" class="velora-input" placeholder="e.g. Lahore">
                <span asp-validation-for="City" class="text-danger" style="font-size:.73rem;"></span>
              </div>
              <div class="col-md-6">
                <label class="velora-label">Postal Code</label>
                <input asp-for="PostalCode" class="velora-input" placeholder="e.g. 54000">
              </div>
              <div class="col-12">
                <label class="velora-label">Phone Number *</label>
                <input asp-for="PhoneNumber" class="velora-input" placeholder="+92 300 1234567">
                <span asp-validation-for="PhoneNumber" class="text-danger" style="font-size:.73rem;"></span>
              </div>
              <div class="col-12">
                <label class="velora-label">Order Notes (optional)</label>
                <textarea asp-for="Notes" class="velora-textarea" rows="2"
                          placeholder="Special instructions for your order..."></textarea>
              </div>
            </div>
          </div>

          <!-- Payment Method -->
          <div style="background:white;border-radius:var(--radius-lg);padding:28px;box-shadow:var(--shadow-sm);">
            <div class="checkout-section-title">
              <i class="fa-solid fa-credit-card me-2"></i>Payment Method
            </div>
            <div class="row g-3">

              <!-- COD -->
              <div class="col-12">
                <label class="payment-method-card selected" id="pm-cod" onclick="selectPayment(1)">
                  <input type="radio" name="PaymentMethod" value="1" checked style="display:none;">
                  <div style="width:42px;height:28px;background:var(--gray-100);border-radius:4px;display:flex;align-items:center;justify-content:center;">
                    <i class="fa-solid fa-truck" style="color:var(--gold);"></i>
                  </div>
                  <div>
                    <div style="font-weight:700;font-size:.88rem;">Cash on Delivery</div>
                    <div style="font-size:.72rem;color:var(--gray-500);">Pay when you receive your order</div>
                  </div>
                  <i class="fa-solid fa-circle-check ms-auto check-icon" style="color:var(--gold);font-size:1rem;"></i>
                </label>
              </div>

              <!-- Credit / Debit Card -->
              <div class="col-12">
                <label class="payment-method-card" id="pm-card" onclick="selectPayment(4)">
                  <input type="radio" name="PaymentMethod" value="4" style="display:none;">
                  <div style="width:42px;height:28px;background:var(--gray-900);border-radius:4px;display:flex;align-items:center;justify-content:center;">
                    <i class="fa-solid fa-credit-card" style="color:white;font-size:.75rem;"></i>
                  </div>
                  <div>
                    <div style="font-weight:700;font-size:.88rem;">Credit / Debit Card</div>
                    <div style="font-size:.72rem;color:var(--gray-500);">Visa &amp; Mastercard accepted</div>
                  </div>
                  <i class="fa-solid fa-circle-check ms-auto check-icon" style="color:var(--gold);font-size:1rem;display:none;"></i>
                </label>
              </div>

              <!-- ═══ CARD DETAILS PANEL (shown only when card selected) ═══ -->
              <div class="col-12" id="cardPanel" style="display:none;">
                <div style="background:var(--gray-50);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);padding:24px;">

                  <!-- Visual card preview -->
                  <div id="cardPreview" style="
                    background:linear-gradient(135deg,#1a1a1a 0%,#2d2d2d 100%);
                    border-radius:14px;padding:22px 24px;margin-bottom:20px;
                    color:white;font-family:'Courier New',monospace;
                    box-shadow:0 8px 32px rgba(0,0,0,0.25);position:relative;overflow:hidden;">
                    <div style="position:absolute;top:-30px;right:-30px;width:130px;height:130px;border-radius:50%;background:rgba(201,168,76,.15);"></div>
                    <div style="position:absolute;bottom:-40px;left:-20px;width:160px;height:160px;border-radius:50%;background:rgba(201,168,76,.08);"></div>
                    <div style="font-size:.65rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-bottom:18px;position:relative;">
                      VELORA CARD
                    </div>
                    <div id="previewNumber" style="font-size:1.15rem;letter-spacing:.18em;margin-bottom:18px;position:relative;">
                      •••• •••• •••• ••••
                    </div>
                    <div style="display:flex;justify-content:space-between;align-items:flex-end;position:relative;">
                      <div>
                        <div style="font-size:.55rem;letter-spacing:.1em;color:rgba(255,255,255,.5);text-transform:uppercase;">Card Holder</div>
                        <div id="previewName" style="font-size:.82rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;">YOUR NAME</div>
                      </div>
                      <div>
                        <div style="font-size:.55rem;letter-spacing:.1em;color:rgba(255,255,255,.5);text-transform:uppercase;">Expires</div>
                        <div id="previewExpiry" style="font-size:.82rem;font-weight:600;">MM/YY</div>
                      </div>
                      <div style="font-size:1.4rem;font-style:italic;font-weight:700;color:rgba(255,255,255,.4);">VISA</div>
                    </div>
                  </div>

                  <!-- Card fields -->
                  <div class="row g-3">
                    <div class="col-12">
                      <label class="velora-label">Card Number *</label>
                      <div style="position:relative;">
                        <input asp-for="CardDetails.CardNumber"
                               class="velora-input" id="cardNumber"
                               placeholder="1234 5678 9012 3456"
                               maxlength="19"
                               autocomplete="cc-number"
                               oninput="formatCardNumber(this)"
                               style="padding-right:52px;letter-spacing:.08em;">
                        <i id="cardBrandIcon" class="fa-brands fa-cc-visa"
                           style="position:absolute;right:14px;top:50%;transform:translateY(-50%);font-size:1.2rem;color:var(--gray-400);"></i>
                      </div>
                      <span asp-validation-for="CardDetails.CardNumber"
                            class="text-danger" style="font-size:.73rem;"></span>
                    </div>

                    <div class="col-12">
                      <label class="velora-label">Name on Card *</label>
                      <input asp-for="CardDetails.CardHolderName"
                             class="velora-input" id="cardName"
                             placeholder="As printed on your card"
                             autocomplete="cc-name"
                             oninput="document.getElementById('previewName').textContent = this.value.toUpperCase() || 'YOUR NAME'">
                      <span asp-validation-for="CardDetails.CardHolderName"
                            class="text-danger" style="font-size:.73rem;"></span>
                    </div>

                    <div class="col-md-6">
                      <label class="velora-label">Expiry Date *</label>
                      <input asp-for="CardDetails.ExpiryDate"
                             class="velora-input" id="cardExpiry"
                             placeholder="MM/YY" maxlength="5"
                             autocomplete="cc-exp"
                             oninput="formatExpiry(this)">
                      <span asp-validation-for="CardDetails.ExpiryDate"
                            class="text-danger" style="font-size:.73rem;"></span>
                    </div>

                    <div class="col-md-6">
                      <label class="velora-label">CVV *
                        <span data-bs-toggle="tooltip"
                              title="3-digit code on the back of your card (4 digits for Amex)"
                              style="cursor:help;color:var(--gray-400);">
                          <i class="fa-solid fa-circle-question" style="font-size:.8rem;"></i>
                        </span>
                      </label>
                      <div style="position:relative;">
                        <input asp-for="CardDetails.CVV"
                               type="password" class="velora-input" id="cardCVV"
                               placeholder="•••" maxlength="4"
                               autocomplete="cc-csc"
                               style="padding-right:44px;">
                        <button type="button"
                                onclick="toggleCVV()"
                                style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--gray-400);font-size:.85rem;">
                          <i class="fa-regular fa-eye" id="cvvEye"></i>
                        </button>
                      </div>
                      <span asp-validation-for="CardDetails.CVV"
                            class="text-danger" style="font-size:.73rem;"></span>
                    </div>

                    <!-- Security notice -->
                    <div class="col-12">
                      <div style="display:flex;align-items:center;gap:8px;background:#e8f5e9;border-radius:var(--radius-sm);padding:10px 14px;">
                        <i class="fa-solid fa-lock" style="color:#4caf50;font-size:.85rem;"></i>
                        <span style="font-size:.75rem;color:#2e7d32;">
                          Your card details are encrypted and never stored. Only the last 4 digits are saved for reference.
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- ───────── RIGHT: Order Summary ───────── -->
        <div class="col-lg-5">
          <div class="cart-summary-box">
            <h5 style="font-weight:700;font-size:1rem;margin-bottom:20px;">Order Summary</h5>

            @if (Model.CartSummary?.Cart?.CartItems != null)
            {
              <div style="max-height:260px;overflow-y:auto;margin-bottom:16px;">
                @foreach (var item in Model.CartSummary.Cart.CartItems)
                {
                  <div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--gray-100);">
                    <div style="position:relative;flex-shrink:0;">
                      <img src="@(item.Product?.ImageUrl ?? "")"
                           style="width:52px;height:64px;object-fit:cover;border-radius:6px;"
                           onerror="this.style.display='none'">
                      <span style="position:absolute;top:-6px;right:-6px;background:var(--gold);color:var(--black);width:18px;height:18px;border-radius:50%;font-size:.6rem;font-weight:800;display:flex;align-items:center;justify-content:center;">
                        @item.Quantity
                      </span>
                    </div>
                    <div style="flex:1;min-width:0;">
                      <div style="font-size:.82rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                        @item.Product?.Name
                      </div>
                      @if (!string.IsNullOrEmpty(item.SelectedSize))
                      {
                        <div style="font-size:.72rem;color:var(--gray-500);">
                          @item.SelectedSize
                          @(!string.IsNullOrEmpty(item.SelectedColor) ? " · " + item.SelectedColor : "")
                        </div>
                      }
                    </div>
                    <span style="font-size:.85rem;font-weight:700;white-space:nowrap;">
                      PKR @item.TotalPrice.ToString("N0")
                    </span>
                  </div>
                }
              </div>
            }

            <div class="cart-summary-row">
              <span>Subtotal</span>
              <span>PKR @Model.CartSummary?.SubTotal.ToString("N0")</span>
            </div>
            <div class="cart-summary-row">
              <span>Shipping</span>
              <span style="@(Model.CartSummary?.FreeShipping == true ? "color:#2e7d32;font-weight:600;" : "")">
                @(Model.CartSummary?.FreeShipping == true
                    ? "FREE"
                    : "PKR " + Model.CartSummary?.ShippingCharges.ToString("N0"))
              </span>
            </div>
            <div class="cart-summary-row">
              <span>Tax (5%)</span>
              <span>PKR @Model.CartSummary?.Tax.ToString("N0")</span>
            </div>
            <div class="cart-summary-row"
                 style="border-top:2px solid var(--gray-200);margin-top:8px;padding-top:16px;">
              <span class="cart-summary-total">Total</span>
              <span class="cart-summary-total-val">
                PKR @Model.CartSummary?.GrandTotal.ToString("N0")
              </span>
            </div>

            <button type="submit" class="btn-velora-primary w-100 mt-4"
                    style="justify-content:center;padding:16px;" id="placeOrderBtn">
              <i class="fa-solid fa-lock me-2"></i>
              <span id="placeOrderText">Place Order</span>
            </button>

            <div style="text-align:center;font-size:.72rem;color:var(--gray-500);margin-top:12px;">
              <i class="fa-solid fa-shield-halved me-1 text-gold"></i>
              Secured with 256-bit SSL encryption
            </div>

            <!-- Accepted cards icons -->
            <div id="cardLogos" style="display:none;text-align:center;margin-top:10px;display:none;">
              <div style="font-size:.68rem;color:var(--gray-400);margin-bottom:6px;">Accepted Cards</div>
              <div style="display:flex;gap:8px;justify-content:center;">
                <div style="background:var(--gray-100);border-radius:4px;padding:4px 10px;font-size:.72rem;font-weight:700;">VISA</div>
                <div style="background:var(--gray-100);border-radius:4px;padding:4px 10px;font-size:.72rem;font-weight:700;">MC</div>
                <div style="background:var(--gray-100);border-radius:4px;padding:4px 10px;font-size:.72rem;font-weight:700;">AMEX</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </form>
  </div>
</section>

@section Scripts {
<script>
// ── Payment method switching ──────────────────────────────────────
        const pmIds = { 1:'pm-cod', 4:'pm-card' };

function selectPayment(value) {
  // Deselect all
  Object.values(pmIds).forEach(id => {
    const el = document.getElementById(id);
    el.classList.remove('selected');
    el.querySelector('.check-icon').style.display = 'none';
    el.querySelector('input[type=radio]').checked  = false;
  });

  // Select chosen
  const chosen = document.getElementById(pmIds[value]);
  chosen.classList.add('selected');
  chosen.querySelector('.check-icon').style.display = 'block';
  chosen.querySelector('input[type=radio]').checked  = true;

  // Show/hide card panel
  const cardPanel = document.getElementById('cardPanel');
  const cardLogos = document.getElementById('cardLogos');
  const btnText   = document.getElementById('placeOrderText');

  if (value === 4) {
    cardPanel.style.display = 'block';
    cardLogos.style.display = 'block';
    btnText.textContent     = 'Pay & Place Order';
    // Enable card field names so they post
    setCardFieldsDisabled(false);
  } else {
    cardPanel.style.display = 'none';
    cardLogos.style.display = 'none';
    btnText.textContent     = 'Place Order';
    setCardFieldsDisabled(true);
  }
}

function setCardFieldsDisabled(disabled) {
  ['CardDetails_CardNumber','CardDetails_CardHolderName',
   'CardDetails_ExpiryDate','CardDetails_CVV'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.disabled = disabled;
  });
}

// ── Card number formatter + brand detection ───────────────────────
function formatCardNumber(input) {
  let raw  = input.value.replace(/\D/g, '').substring(0, 16);
  let fmt  = raw.replace(/(.{4})/g, '$1 ').trim();
  input.value = fmt;

  // Live preview
  document.getElementById('previewNumber').textContent =
    fmt.padEnd(19, '•').replace(/[0-9]/g, (c, i) => i < fmt.length ? c : '•')
    || '•••• •••• •••• ••••';

  // Brand icon
  const icon = document.getElementById('cardBrandIcon');
  if      (/^4/.test(raw))  { icon.className = 'fa-brands fa-cc-visa';       icon.style.color='#1a1f71'; }
  else if (/^5[1-5]/.test(raw)) { icon.className = 'fa-brands fa-cc-mastercard'; icon.style.color='#eb001b'; }
  else if (/^3[47]/.test(raw))  { icon.className = 'fa-brands fa-cc-amex';   icon.style.color='#007bc1'; }
  else    { icon.className = 'fa-solid fa-credit-card';  icon.style.color='var(--gray-400)'; }
}

// ── Expiry formatter ─────────────────────────────────────────────
function formatExpiry(input) {
  let raw = input.value.replace(/\D/g, '').substring(0, 4);
  if (raw.length >= 3) raw = raw.substring(0,2) + '/' + raw.substring(2);
  input.value = raw;
  document.getElementById('previewExpiry').textContent = raw || 'MM/YY';
}

// ── CVV toggle ───────────────────────────────────────────────────
function toggleCVV() {
  const input = document.getElementById('cardCVV');
  const icon  = document.getElementById('cvvEye');
  if (input.type === 'password') { input.type='text';     icon.classList.replace('fa-eye','fa-eye-slash'); }
  else                           { input.type='password'; icon.classList.replace('fa-eye-slash','fa-eye'); }
}

// ── Init: disable card fields by default ─────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  setCardFieldsDisabled(true);

  // Re-enable if card was already selected (e.g. form re-displayed after error)
  const selectedValue = @((int)Model.PaymentMethod);
  if (selectedValue === 4) selectPayment(4);

  // Bootstrap tooltips
  document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
    new bootstrap.Tooltip(el);
  });
});
</script>
}
