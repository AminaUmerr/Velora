<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="description" content="Velora — Premium Fashion & Lifestyle Store">
  <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | " : "")VELORA</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;600;700;900&display=swap" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Bootstrap 5 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

  <!-- Velora CSS -->
  <link rel="stylesheet" href="~/css/velora.css" asp-append-version="true">

  @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- Page Loader -->
<div class="page-loader" id="pageLoader">
  <div class="loader-logo">VELORA</div>
  <div class="loader-spinner"></div>
</div>

<!-- TempData Inputs (for JS toasts) -->
<input type="hidden" id="tempSuccess" value="@TempData["Success"]">
<input type="hidden" id="tempError"   value="@TempData["Error"]">
<input type="hidden" id="tempInfo"    value="@TempData["Info"]">

<!-- Anti-forgery token for AJAX -->
@Html.AntiForgeryToken()

<!-- ═══════════════════════════════════════════════════════════
     NAVBAR
═══════════════════════════════════════════════════════════════ -->
<nav class="velora-navbar navbar navbar-expand-lg">
  <div class="container">

    <!-- Brand -->
    <a class="navbar-brand navbar-brand-logo me-4" asp-controller="Home" asp-action="Index">
      VEL<span>ORA</span>
    </a>

    <!-- Mobile Toggle -->
    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMain">
      <!-- Nav Links -->
      <ul class="navbar-nav me-auto gap-0">
        <li class="nav-item">
          <a class="nav-link velora-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
             asp-controller="Home" asp-action="Index">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link velora-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Shop" ? "active" : "")"
             asp-controller="Shop" asp-action="Index">Shop</a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link velora-nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Collections</a>
          <ul class="dropdown-menu border-0 shadow-lg p-2" style="border-radius:12px;min-width:200px;">
            <li><a class="dropdown-item" asp-controller="Shop" asp-action="Index" asp-route-categoryId="1">Clothes</a></li>
            <li><a class="dropdown-item" asp-controller="Shop" asp-action="Index" asp-route-categoryId="2">Shoes</a></li>
            <li><a class="dropdown-item" asp-controller="Shop" asp-action="Index" asp-route-categoryId="3">Watches</a></li>
            <li><a class="dropdown-item" asp-controller="Shop" asp-action="Index" asp-route-categoryId="4">Bags</a></li>
            <li><a class="dropdown-item" asp-controller="Shop" asp-action="Index" asp-route-categoryId="5">Accessories</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <a class="nav-link velora-nav-link" asp-controller="Home" asp-action="About">About</a>
        </li>
        <li class="nav-item">
          <a class="nav-link velora-nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
        </li>
      </ul>

      <!-- Search -->
      <div class="navbar-search-wrapper me-3 d-none d-lg-block">
        <input type="text" class="navbar-search-input" placeholder="Search products..." autocomplete="off" id="navSearch">
        <button class="navbar-search-btn" type="button">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </div>

      <!-- Icons -->
      <div class="d-flex align-items-center gap-1">

        @if (User.Identity?.IsAuthenticated == true)
        {
          <!-- Wishlist -->
          <a asp-controller="User" asp-action="Wishlist" class="navbar-icon-btn" title="Wishlist">
            <i class="fa-regular fa-heart"></i>
          </a>

          <!-- Cart -->
          <a asp-controller="Cart" asp-action="Index" class="navbar-icon-btn" title="Cart">
            <i class="fa-solid fa-bag-shopping"></i>
            <span class="cart-badge" id="cartBadge" style="display:none">0</span>
          </a>

          <!-- User Dropdown -->
          <div class="dropdown">
            <button class="navbar-icon-btn" data-bs-toggle="dropdown">
              <i class="fa-regular fa-circle-user"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg p-2" style="border-radius:12px;min-width:200px;">
              <li class="px-3 py-2">
                <div style="font-size:.8rem;font-weight:700;">@User.Identity.Name</div>
              </li>
              <li><hr class="dropdown-divider m-1"></li>
              <li><a class="dropdown-item" asp-controller="User" asp-action="Dashboard"><i class="fa-solid fa-grid-2 me-2 text-gold"></i>Dashboard</a></li>
              <li><a class="dropdown-item" asp-controller="User" asp-action="Orders"><i class="fa-solid fa-box me-2 text-gold"></i>My Orders</a></li>
              <li><a class="dropdown-item" asp-controller="User" asp-action="Profile"><i class="fa-solid fa-user-pen me-2 text-gold"></i>Profile</a></li>
              @if (User.IsInRole("Admin"))
              {
                <li><hr class="dropdown-divider m-1"></li>
                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-shield-halved me-2 text-gold"></i>Admin Panel</a></li>
              }
              <li><hr class="dropdown-divider m-1"></li>
              <li>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                  @Html.AntiForgeryToken()
                  <button type="submit" class="dropdown-item text-danger">
                    <i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Logout
                  </button>
                </form>
              </li>
            </ul>
          </div>
        }
        else
        {
          <a asp-controller="Account" asp-action="Login" class="navbar-icon-btn" title="Cart">
            <i class="fa-solid fa-bag-shopping"></i>
            <span class="cart-badge" id="cartBadge" style="display:none">0</span>
          </a>
          <a asp-controller="Account" asp-action="Login" class="btn-velora-dark ms-2" style="padding:9px 20px;font-size:.75rem;">
            Sign In
          </a>
          <a asp-controller="Account" asp-action="Register" class="btn-velora-ghost ms-1" style="padding:9px 20px;font-size:.75rem;">
            Register
          </a>
        }
      </div>
    </div>
  </div>
</nav>

<!-- ═══════════════════════════════════════════════════════════
     MAIN CONTENT
═══════════════════════════════════════════════════════════════ -->
<main>
  @RenderBody()
</main>

<!-- ═══════════════════════════════════════════════════════════
     FOOTER
═══════════════════════════════════════════════════════════════ -->
<footer class="velora-footer">
  <div class="container">
    <div class="row g-5">

      <!-- Brand Column -->
      <div class="col-lg-4 col-md-6">
        <div class="footer-brand">VELORA</div>
        <p class="footer-tagline">
          Premium fashion &amp; lifestyle destination. Curated collections for the discerning individual.
        </p>
        <div class="d-flex gap-2 mt-4">
          <a href="#" class="social-btn"><i class="fab fa-instagram"></i></a>
          <a href="#" class="social-btn"><i class="fab fa-facebook-f"></i></a>
          <a href="#" class="social-btn"><i class="fab fa-twitter"></i></a>
          <a href="#" class="social-btn"><i class="fab fa-tiktok"></i></a>
          <a href="#" class="social-btn"><i class="fab fa-pinterest-p"></i></a>
        </div>
      </div>

      <!-- Shop Links -->
      <div class="col-lg-2 col-md-3 col-6">
        <div class="footer-heading">Shop</div>
        <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="1" class="footer-link">Clothes</a>
        <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="2" class="footer-link">Shoes</a>
        <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="3" class="footer-link">Watches</a>
        <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="4" class="footer-link">Bags</a>
        <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="5" class="footer-link">Accessories</a>
      </div>

      <!-- Help Links -->
      <div class="col-lg-2 col-md-3 col-6">
        <div class="footer-heading">Help</div>
        <a asp-controller="Home" asp-action="About" class="footer-link">About Us</a>
        <a asp-controller="Home" asp-action="Contact" class="footer-link">Contact</a>
        <a asp-controller="Home" asp-action="FAQ" class="footer-link">FAQ</a>
        <a href="#" class="footer-link">Shipping Policy</a>
        <a href="#" class="footer-link">Returns</a>
      </div>

      <!-- Contact Info -->
      <div class="col-lg-4 col-md-6">
        <div class="footer-heading">Get In Touch</div>
        <div class="d-flex align-items-start gap-3 mb-3">
          <i class="fa-solid fa-location-dot text-gold mt-1" style="width:16px"></i>
          <span style="font-size:.83rem;">Liberty Market, Gulberg III,<br>Lahore, Pakistan</span>
        </div>
        <div class="d-flex align-items-center gap-3 mb-3">
          <i class="fa-solid fa-phone text-gold" style="width:16px"></i>
          <span style="font-size:.83rem;">+92 300 1234567</span>
        </div>
        <div class="d-flex align-items-center gap-3 mb-3">
          <i class="fa-solid fa-envelope text-gold" style="width:16px"></i>
          <span style="font-size:.83rem;">hello@velora.pk</span>
        </div>
        <div class="d-flex align-items-center gap-3">
          <i class="fa-solid fa-clock text-gold" style="width:16px"></i>
          <span style="font-size:.83rem;">Mon–Sat: 10am – 8pm</span>
        </div>
      </div>

    </div>
  </div>

  <div class="divider-gold mt-5"></div>
  <div class="container footer-bottom">
    <span>© @DateTime.Now.Year <strong>VELORA</strong>. All rights reserved.</span>
    <div class="d-flex align-items-center gap-3">
      <img src="https://img.icons8.com/color/32/visa.png" alt="Visa" height="22">
      <img src="https://img.icons8.com/color/32/mastercard.png" alt="Mastercard" height="22">
      <span style="font-size:.72rem;color:rgba(255,255,255,.25);">JazzCash &nbsp; EasyPaisa &nbsp; COD</span>
    </div>
  </div>
</footer>

<!-- Toast Container -->
<div class="toast-container-velora"></div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Font Awesome Kit (Free CDN) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/js/all.min.js" defer></script>

<!-- Velora JS -->
<script src="~/js/velora.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
