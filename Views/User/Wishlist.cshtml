@* Wishlist View *@
@model Velora.Models.Wishlist
@{
    ViewData["Title"] = "My Wishlist";
}
<div style="background:var(--gray-50);min-height:80vh;padding:40px 0;">
  <div class="container">
    <div class="row g-4">
      @await Html.PartialAsync("_UserSidebar")
      <div class="col-lg-9">
        <div style="margin-bottom:20px;">
          <h4 style="font-weight:700;font-size:1.1rem;margin:0;">
            <i class="fa-solid fa-heart text-gold me-2"></i>My Wishlist
            @if (Model?.WishlistItems.Any() == true)
            {
              <span style="font-size:.85rem;font-weight:400;color:var(--gray-500);margin-left:8px;">
                (@Model.WishlistItems.Count items)
              </span>
            }
          </h4>
        </div>

        @if (Model?.WishlistItems.Any() == true)
        {
          <div class="row g-4">
            @foreach (var item in Model.WishlistItems)
            {
              <div class="col-6 col-md-4 col-lg-4">
                <div class="product-card" style="position:relative;">
                  <button class="card-action-btn active"
                          style="position:absolute;top:12px;right:12px;z-index:3;"
                          onclick="Velora.toggleWishlist(@item.ProductId, this)"
                          title="Remove from Wishlist">
                    <i class="fa-solid fa-heart"></i>
                  </button>
                  @if (item.Product != null)
                  {
                    <div class="product-card-img-wrapper">
                      <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId">
                        <img src="@(item.Product.ImageUrl ?? "https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=600")"
                             alt="@item.Product.Name" class="product-card-img"
                             onerror="this.src='https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=600'">
                      </a>
                    </div>
                    <div class="product-card-body">
                      <div class="product-category-tag">@item.Product.Category?.Name</div>
                      <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId">
                        <h3 class="product-name">@item.Product.Name</h3>
                      </a>
                      <div class="product-price-wrapper">
                        <span class="product-price">PKR @item.Product.FinalPrice.ToString("N0")</span>
                        @if (item.Product.DiscountPercentage > 0)
                        { <span class="product-discount">@item.Product.DiscountPercentage% OFF</span> }
                      </div>
                    </div>
                    <div class="product-card-footer" style="opacity:1;transform:none;">
                      <button class="btn-add-cart-quick" data-quick-add data-product-id="@item.ProductId">
                        <i class="fa-solid fa-bag-shopping"></i> Add to Cart
                      </button>
                    </div>
                  }
                </div>
              </div>
            }
          </div>
        }
        else
        {
          <div class="empty-state">
            <div class="empty-state-icon"><i class="fa-regular fa-heart"></i></div>
            <h4 class="empty-state-title">Your Wishlist is Empty</h4>
            <p class="empty-state-text">Save items you love to your wishlist and shop them later.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn-velora-primary">
              <i class="fa-solid fa-store me-2"></i> Explore Products
            </a>
          </div>
        }
      </div>
    </div>
  </div>
</div>
