@model Velora.Models.Order
@{
    ViewData["Title"] = $"Order {Model.OrderNumber}";
}
<div style="background:var(--gray-50);min-height:80vh;padding:40px 0;">
  <div class="container">
    <div class="row g-4">
      @await Html.PartialAsync("_UserSidebar")
      <div class="col-lg-9">

        <!-- Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:24px;">
          <div>
            <a asp-controller="User" asp-action="Orders" style="font-size:.8rem;color:var(--gray-500);">
              <i class="fa-solid fa-arrow-left me-1"></i> All Orders
            </a>
            <h4 style="font-weight:700;font-size:1.1rem;margin-top:6px;margin-bottom:0;">
              Order <span style="color:var(--gold);">@Model.OrderNumber</span>
            </h4>
          </div>
          <span class="status-badge status-@Model.Status.ToString().ToLower()" style="font-size:.82rem;padding:6px 18px;">
            @Model.Status
          </span>
        </div>

        <div class="row g-4">
          <!-- Items -->
          <div class="col-lg-8">
            <div style="background:white;border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow-sm);">
              <h6 style="font-weight:700;margin-bottom:16px;">Order Items</h6>
              @foreach (var item in Model.OrderItems)
              {
                <div style="display:flex;align-items:center;gap:16px;padding:14px 0;border-bottom:1px solid var(--gray-100);">
                  @if (!string.IsNullOrEmpty(item.ProductImage))
                  {
                    <img src="@item.ProductImage" style="width:60px;height:72px;object-fit:cover;border-radius:6px;">
                  }
                  else
                  {
                    <div style="width:60px;height:72px;background:var(--gray-100);border-radius:6px;"></div>
                  }
                  <div style="flex:1;">
                    <div style="font-weight:600;font-size:.9rem;">@item.ProductName</div>
                    @if (!string.IsNullOrEmpty(item.SelectedSize))
                    { <div style="font-size:.75rem;color:var(--gray-500);">Size: @item.SelectedSize</div> }
                    @if (!string.IsNullOrEmpty(item.SelectedColor))
                    { <div style="font-size:.75rem;color:var(--gray-500);">Color: @item.SelectedColor</div> }
                    <div style="font-size:.78rem;color:var(--gray-500);">
                      PKR @item.UnitPrice.ToString("N0") × @item.Quantity
                    </div>
                  </div>
                  <strong>PKR @item.TotalPrice.ToString("N0")</strong>
                </div>
              }
            </div>
          </div>

          <!-- Summary -->
          <div class="col-lg-4">
            <div style="background:white;border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow-sm);margin-bottom:16px;">
              <h6 style="font-weight:700;margin-bottom:16px;">Order Summary</h6>
              <div class="cart-summary-row"><span>Subtotal</span><span>PKR @Model.SubTotal.ToString("N0")</span></div>
              <div class="cart-summary-row"><span>Shipping</span><span>@(Model.ShippingCharges == 0 ? "FREE" : "PKR " + Model.ShippingCharges.ToString("N0"))</span></div>
              <div class="cart-summary-row"><span>Tax</span><span>PKR @Model.Tax.ToString("N0")</span></div>
              <div class="cart-summary-row" style="border-top:2px solid var(--gray-200);padding-top:12px;margin-top:8px;">
                <span style="font-weight:700;">Total</span>
                <span style="font-weight:800;color:var(--gold);">PKR @Model.GrandTotal.ToString("N0")</span>
              </div>
            </div>

            <div style="background:white;border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow-sm);">
              <h6 style="font-weight:700;margin-bottom:12px;">Shipping To</h6>
              <div style="font-size:.85rem;color:var(--gray-700);line-height:1.8;">
                <div><strong>@Model.FullName</strong></div>
                <div>@Model.ShippingAddress</div>
                <div>@Model.City @Model.PostalCode</div>
                <div>@Model.PhoneNumber</div>
              </div>
              <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--gray-100);">
                <div style="font-size:.72rem;color:var(--gray-500);">Payment Method</div>
                <div style="font-size:.85rem;font-weight:600;margin-top:3px;">
                  @Model.PaymentMethod.ToString().Replace("CreditDebitCard","Credit/Debit Card")
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
