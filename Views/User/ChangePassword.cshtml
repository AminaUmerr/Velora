@model Velora.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}
<div style="background:var(--gray-50);min-height:80vh;padding:40px 0;">
  <div class="container">
    <div class="row g-4">
      @await Html.PartialAsync("_UserSidebar")
      <div class="col-lg-9">
        <div style="background:white;border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-sm);max-width:520px;">
          <h4 style="font-weight:700;font-size:1.1rem;margin-bottom:28px;padding-bottom:16px;border-bottom:1px solid var(--gray-200);">
            <i class="fa-solid fa-lock text-gold me-2"></i>Change Password
          </h4>
          <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="velora-alert velora-alert-error mb-3"></div>
            <div class="mb-3">
              <label class="velora-label">Current Password</label>
              <input asp-for="CurrentPassword" type="password" class="velora-input">
              <span asp-validation-for="CurrentPassword" class="text-danger" style="font-size:.73rem;"></span>
            </div>
            <div class="mb-3">
              <label class="velora-label">New Password</label>
              <input asp-for="NewPassword" type="password" class="velora-input">
              <span asp-validation-for="NewPassword" class="text-danger" style="font-size:.73rem;"></span>
            </div>
            <div class="mb-4">
              <label class="velora-label">Confirm New Password</label>
              <input asp-for="ConfirmNewPassword" type="password" class="velora-input">
              <span asp-validation-for="ConfirmNewPassword" class="text-danger" style="font-size:.73rem;"></span>
            </div>
            <button type="submit" class="btn-velora-primary">
              <i class="fa-solid fa-lock me-2"></i>Update Password
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
