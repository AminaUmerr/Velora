@{
    ViewData["Title"] = "Page Not Found";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="error-page">
  <div class="container text-center">
    <div class="error-code animate-fadeInUp">404</div>
    <h2 class="error-title animate-fadeInUp delay-100">Page Not Found</h2>
    <p style="color:var(--gray-500);font-size:.95rem;max-width:420px;margin:16px auto 36px;line-height:1.7;"
       class="animate-fadeInUp delay-200">
      The page you're looking for doesn't exist or may have been moved.
    </p>
    <div class="d-flex gap-3 justify-content-center animate-fadeInUp delay-300">
      <a asp-controller="Home" asp-action="Index" class="btn-velora-primary">
        <i class="fa-solid fa-house me-2"></i> Go Home
      </a>
      <a asp-controller="Shop" asp-action="Index" class="btn-velora-ghost">
        Browse Shop
      </a>
    </div>
  </div>
</div>
