@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="error-page">
  <div class="container text-center">
    <div style="width:90px;height:90px;background:rgba(201,168,76,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
      <i class="fa-solid fa-lock text-gold" style="font-size:2rem;"></i>
    </div>
    <div class="error-code animate-fadeInUp" style="font-size:clamp(4rem,12vw,8rem);">403</div>
    <h2 class="error-title animate-fadeInUp delay-100">Access Denied</h2>
    <p style="color:var(--gray-500);font-size:.95rem;max-width:420px;margin:16px auto 36px;line-height:1.7;"
       class="animate-fadeInUp delay-200">
      You don't have permission to view this page.
    </p>
    <div class="d-flex gap-3 justify-content-center animate-fadeInUp delay-300">
      <a asp-controller="Home" asp-action="Index" class="btn-velora-primary">
        <i class="fa-solid fa-house me-2"></i> Go Home
      </a>
      <a asp-controller="Account" asp-action="Login" class="btn-velora-ghost">
        Sign In
      </a>
    </div>
  </div>
</div>
