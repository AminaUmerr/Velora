@{
    ViewData["Title"] = "Check Your Email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="auth-page" style="background:var(--gray-50);">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="form-card animate-scaleIn text-center">
          <div style="width:64px;height:64px;background:#e8f5e9;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
            <i class="fa-solid fa-envelope-circle-check" style="color:#4caf50;font-size:1.3rem;"></i>
          </div>
          <h2 style="font-size:1.4rem;font-weight:700;margin-bottom:8px;">Check Your Email</h2>
          <p style="color:var(--gray-500);font-size:.88rem;line-height:1.7;">
            If an account exists with that email, we've sent password reset instructions. Please check your inbox.
          </p>
          <a asp-action="Login" class="btn-velora-dark mt-4" style="display:inline-flex;justify-content:center;">
            Back to Sign In
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
