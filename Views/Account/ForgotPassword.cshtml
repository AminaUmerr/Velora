@model Velora.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="auth-page" style="background:var(--gray-50);">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="form-card animate-scaleIn text-center">
          <div style="width:64px;height:64px;background:rgba(201,168,76,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
            <i class="fa-solid fa-lock text-gold" style="font-size:1.3rem;"></i>
          </div>
          <h2 style="font-size:1.4rem;font-weight:700;margin-bottom:8px;">Reset Password</h2>
          <p style="color:var(--gray-500);font-size:.85rem;margin-bottom:28px;">
            Enter your email address and we'll send you a link to reset your password.
          </p>
          <form asp-action="ForgotPassword" method="post" class="text-start">
            @Html.AntiForgeryToken()
            <div class="mb-4">
              <label class="velora-label">Email Address</label>
              <input asp-for="Email" class="velora-input" placeholder="you@example.com">
              <span asp-validation-for="Email" class="text-danger" style="font-size:.73rem;"></span>
            </div>
            <button type="submit" class="btn-velora-primary w-100" style="justify-content:center;">
              Send Reset Link
            </button>
          </form>
          <a asp-action="Login" style="display:block;margin-top:20px;font-size:.82rem;color:var(--gray-500);">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Sign In
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
