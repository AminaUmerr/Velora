@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="error-page">
  <div class="container text-center">
    <div style="width:80px;height:80px;background:rgba(201,168,76,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
      <i class="fa-solid fa-lock text-gold" style="font-size:1.8rem;"></i>
    </div>
    <div class="error-code" style="font-size:clamp(4rem,10vw,7rem);">403</div>
    <h2 class="error-title">Access Denied</h2>
    <p style="color:var(--gray-500);max-width:380px;margin:14px auto 32px;font-size:.92rem;line-height:1.7;">
      You don't have permission to access this area. Please sign in with the correct account.
    </p>
    <div class="d-flex gap-3 justify-content-center">
      <a asp-controller="Home" asp-action="Index" class="btn-velora-primary">
        <i class="fa-solid fa-house me-2"></i>Go Home
      </a>
      <a asp-controller="Account" asp-action="Login" class="btn-velora-ghost">Sign In</a>
    </div>
  </div>
</div>
